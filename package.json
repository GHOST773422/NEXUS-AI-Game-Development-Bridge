{
  "name": "nexus-bridge",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:code": "oxlint -c config/.oxlintrc.json src sdk integrations tools server.ts tests/ts",
    "format": "prettier --config config/.prettierrc --write src sdk integrations tools server.ts tests/ts",
    "format:check": "prettier --config config/.prettierrc --check src sdk integrations tools server.ts tests/ts",
    "test": "vitest run",
    "check:structure": "node scripts/dev-check.mjs",
    "sync:godot-addon": "node scripts/sync-godot-addon.mjs",
    "stage:adapters": "node scripts/stage-adapter-resources.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.15.0",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
